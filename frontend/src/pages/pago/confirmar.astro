---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabaseClient } from '../../lib/supabase/client';

// Esta página se renderiza estáticamente y usa JavaScript del lado del cliente
// para manejar la confirmación del pago
// Puede recibir token_ws (pago normal) o TBK_TOKEN (pago cancelado)
const { orderId, token_ws, TBK_TOKEN, TBK_ID_SESION, TBK_ORDEN_COMPRA } = Astro.url.searchParams;
---

<BaseLayout title="Confirmación de Pago - Mimoto">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 md:py-16 space-y-6 sm:space-y-8">
    <div class="text-center mb-6 sm:mb-8">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-2">Confirmando tu pago</h1>
      <p class="text-sm sm:text-base text-white/80">Por favor espera mientras procesamos tu transacción...</p>
    </div>

    <div id="payment-status" class="bg-gray-900/50 border-2 border-primary rounded-xl p-4 sm:p-6 md:p-8 shadow-lg space-y-4 sm:space-y-6 backdrop-blur-sm">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-primary/10 mb-3 sm:mb-4">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-primary animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </div>
        <p class="text-white/90 text-base sm:text-lg">Procesando tu pago...</p>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const statusEl = document.getElementById('payment-status');
      const urlParams = new URLSearchParams(window.location.search);
      const orderId = urlParams.get('orderId');
      
      // Detectar si viene TBK_TOKEN (cancelación) o token_ws (pago normal)
      const tbkToken = urlParams.get('TBK_TOKEN');
      const tokenWs = urlParams.get('token_ws');
      
      // CASO 1: Pago cancelado por el usuario (TBK_TOKEN presente)
      if (tbkToken) {
        const tbkIdSesion = urlParams.get('TBK_ID_SESION');
        const tbkOrdenCompra = urlParams.get('TBK_ORDEN_COMPRA');
        
        console.log('🚫 Pago cancelado por el usuario');
        console.log('📋 Parámetros de cancelación:', {
          TBK_TOKEN: tbkToken,
          TBK_ID_SESION: tbkIdSesion,
          TBK_ORDEN_COMPRA: tbkOrdenCompra
        });
        
        statusEl.innerHTML = `
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-yellow-500/10 mb-3 sm:mb-4">
              <svg class="w-8 h-8 sm:w-10 sm:h-10 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Pago Cancelado</h2>
            <p class="text-white/90 mb-3 sm:mb-4 text-sm sm:text-base">Has cancelado el proceso de pago en Webpay.</p>
            <p class="text-white/70 text-xs sm:text-sm mb-4">No se ha realizado ningún cargo a tu tarjeta.</p>
            <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
              <a href="/pago?orderId=${orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
                Intentar nuevamente
              </a>
              <a href="/" class="inline-block px-4 sm:px-6 py-2 sm:py-3 border-2 border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors text-sm sm:text-base">
                Volver al inicio
              </a>
            </div>
          </div>
        `;
        return;
      }

      // CASO 2: Pago normal (token_ws presente)
      if (!tokenWs) {
        statusEl.innerHTML = `
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-500/10 mb-3 sm:mb-4">
              <svg class="w-8 h-8 sm:w-10 sm:h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Error</h2>
            <p class="text-white/90 mb-3 sm:mb-4 text-sm sm:text-base">No se recibió el token de la transacción.</p>
            <a href="/pago?orderId=${orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
              Volver al pago
            </a>
          </div>
        `;
        return;
      }

      try {
        console.log('🔄 Iniciando confirmación de pago...');
        console.log('🔑 Token:', tokenWs);
        console.log('📋 OrderId:', orderId);
        
        // Confirmar la transacción con timeout más largo (30 segundos)
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 30000); // 30 segundos
        
        // Llamar al backend NestJS para confirmar la transacción
        // IMPORTANTE: El commit SOLO se hace en el backend
        const backendUrl = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:3001';
        const response = await fetch(`${backendUrl}/api/webpay/confirm`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ token_ws: tokenWs }),
          signal: controller.signal
        });
        
        clearTimeout(timeoutId);

        console.log('📥 Respuesta HTTP:', response.status, response.statusText);
        
        if (!response.ok) {
          const errorText = await response.text();
          console.error('❌ Error HTTP:', errorText);
          throw new Error(`Error ${response.status}: ${errorText}`);
        }

        const result = await response.json();
        console.log('📋 Resultado de confirmación del backend:', {
          status: result.status,
          response: result.response
        });

        /**
         * El frontend SOLO muestra lo que el backend le dice
         * NO interpreta responseCode, authorizationCode, transactionDate, etc.
         * Usa solo el campo claro 'status' que viene del backend
         */
        const status = result.status; // 'approved' | 'rejected' | 'cancelled'
        
        console.log('🔍 Estado del pago (solo basado en backend):', {
          status: status
        });

        // Mostrar resultado según status del backend
        if (status === 'approved') {
          // Verificar si ya fue confirmado anteriormente
          const response = result.response || {};
          if (response.alreadyConfirmed) {
            statusEl.innerHTML = `
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-blue-500/10 mb-3 sm:mb-4">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Pago Ya Confirmado</h2>
              <p class="text-white/90 mb-3 sm:mb-4 text-sm sm:text-base">Esta transacción ya fue procesada y confirmada anteriormente.</p>
              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
                <a href="/pedido/${result.orderId || orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
                  Ver mi pedido
                </a>
                <a href="/" class="inline-block px-4 sm:px-6 py-2 sm:py-3 border-2 border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors text-sm sm:text-base">
                  Volver al inicio
                </a>
              </div>
            </div>
          `;
          } else {
          // Pago exitoso - Mostrar información completa según requerimientos de Transbank
          const formatAmount = (amount) => {
            if (!amount) return 'N/A';
            if (typeof amount === 'number') {
              return `$${amount.toLocaleString('es-CL')} CLP`;
            }
            return amount;
          };
          
          const formatDate = (dateString) => {
            if (!dateString) return 'N/A';
            try {
              const date = new Date(dateString);
              return date.toLocaleString('es-CL', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric', 
                hour: '2-digit', 
                minute: '2-digit' 
              });
            } catch (e) {
              return dateString;
            }
          };
          
          const getPaymentType = (paymentTypeCode) => {
            const types = {
              'VD': 'Débito',
              'VN': 'Crédito',
              'VC': 'Crédito en Cuotas',
              'SI': 'Sin interés',
              'S2': 'Sin interés (2 cuotas)',
              'NC': 'Sin cuotas'
            };
            return types[paymentTypeCode] || 'N/A';
          };
          
          const getCardLastDigits = (cardDetail) => {
            if (!cardDetail) return 'N/A';
            if (typeof cardDetail === 'object' && cardDetail.cardNumber) {
              return cardDetail.cardNumber.slice(-4);
            }
            if (typeof cardDetail === 'string') {
              return cardDetail.slice(-4);
            }
            return 'N/A';
          };
          
          // Pago exitoso - Mostrar información completa según requerimientos de Transbank
          const response = result.response || {};
          const installmentsText = response.installmentsNumber > 0 
            ? `${response.installmentsNumber} cuota${response.installmentsNumber > 1 ? 's' : ''}`
            : 'Sin cuotas';
          
          statusEl.innerHTML = `
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-green-500/10 mb-3 sm:mb-4">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">¡Pago Exitoso!</h2>
              <p class="text-white/90 mb-3 sm:mb-4 text-sm sm:text-base">Tu pago ha sido procesado correctamente.</p>
              
              <!-- Comprobante completo según requerimientos de Transbank -->
              <div class="bg-gray-800/50 border-2 border-primary/30 rounded-lg p-4 sm:p-6 space-y-2 sm:space-y-3 mb-3 sm:mb-4 text-left">
                <h3 class="text-base sm:text-lg font-bold text-primary mb-3 sm:mb-4 text-center">Comprobante de Pago</h3>
                
                <!-- Nombre del comercio -->
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center pb-2 border-b border-gray-700 gap-1 sm:gap-0">
                  <span class="text-white/90 font-semibold text-sm sm:text-base">Comercio:</span>
                  <span class="font-bold text-primary text-sm sm:text-base">MIMOTO</span>
                </div>
                
                <!-- Número de orden de pedido -->
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Número de orden:</span>
                  <span class="font-bold text-primary text-sm sm:text-base break-all">${response.buyOrder || response.orderId || 'N/A'}</span>
                </div>
                
                <!-- Monto y moneda -->
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Monto pagado:</span>
                  <span class="font-bold text-primary text-sm sm:text-base">${formatAmount(response.amount)}</span>
                </div>
                
                <!-- Código de autorización -->
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Código de autorización:</span>
                  <span class="font-bold text-primary text-sm sm:text-base break-all">${response.authorizationCode || 'N/A'}</span>
                </div>
                
                <!-- Fecha de la transacción -->
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Fecha de transacción:</span>
                  <span class="font-bold text-primary text-sm sm:text-base">${formatDate(response.transactionDate)}</span>
                </div>
                
                <!-- Tipo de pago -->
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Tipo de pago:</span>
                  <span class="font-bold text-primary text-sm sm:text-base">${getPaymentType(response.paymentTypeCode)}</span>
                </div>
                
                <!-- Cantidad de cuotas -->
                ${response.installmentsNumber > 0 ? `
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Cuotas:</span>
                  <span class="font-bold text-primary text-sm sm:text-base">${installmentsText}</span>
                </div>
                ` : ''}
                
                <!-- Últimos 4 dígitos de la tarjeta -->
                <div class="flex flex-col sm:flex-row sm:justify-between gap-1 sm:gap-0">
                  <span class="text-white/90 text-sm sm:text-base">Tarjeta terminada en:</span>
                  <span class="font-bold text-primary text-sm sm:text-base">****${getCardLastDigits(response.cardDetail)}</span>
                </div>
                
                <!-- Descripción de bienes/servicios -->
                ${response.orderItems && response.orderItems.length > 0 ? `
                <div class="pt-2 border-t border-gray-700">
                  <span class="text-white/90 font-semibold block mb-2">Productos:</span>
                  <ul class="space-y-1">
                    ${response.orderItems.map(item => `
                      <li class="text-white/80 text-sm">• ${item.name || item.product_name || 'Producto'} - ${item.quantity || 1} unidad(es) - $${Number(item.price || 0).toLocaleString('es-CL')}</li>
                    `).join('')}
                  </ul>
                </div>
                ` : ''}
              </div>
              
              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
                <a href="/pedido/${response.orderId || orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
                  Ver mi pedido
                </a>
                <a href="/" class="inline-block px-4 sm:px-6 py-2 sm:py-3 border-2 border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors text-sm sm:text-base">
                  Volver al inicio
                </a>
              </div>
            </div>
          `;
          }
        } else if (status === 'rejected') {
          // Pago rechazado - Mostrar información del pedido
          const response = result.response || {};
          console.log('❌ Pago rechazado, detalles:', {
            responseCode: response.responseCode,
            responseMessage: response.responseMessage,
            orderId: response.orderId
          });
          
          statusEl.innerHTML = `
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-500/10 mb-3 sm:mb-4">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Pago Rechazado</h2>
              <p class="text-white/90 mb-2 text-sm sm:text-base">${response.responseMessage || 'Tu pago no pudo ser procesado.'}</p>
              <p class="text-white/70 text-xs sm:text-sm mb-3 sm:mb-4">Código de respuesta: ${response.responseCode || 'N/A'}</p>
              
              ${response.orderId ? `
              <div class="bg-gray-800/50 border-2 border-primary/30 rounded-lg p-3 sm:p-4 mb-3 sm:mb-4">
                <p class="text-white/90 text-sm sm:text-base">ID del pedido: <span class="font-bold text-primary">#${response.orderId}</span></p>
                ${response.amount ? `<p class="text-white/90 mt-2 text-sm sm:text-base">Monto: <span class="font-bold text-primary">$${Number(response.amount).toLocaleString('es-CL')} CLP</span></p>` : ''}
              </div>
              ` : ''}
              
              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
                <a href="/pago?orderId=${orderId || response.orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
                  Intentar nuevamente
                </a>
                <a href="/" class="inline-block px-4 sm:px-6 py-2 sm:py-3 border-2 border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors text-sm sm:text-base">
                  Volver al inicio
                </a>
              </div>
            </div>
          `;
        } else if (status === 'cancelled') {
          // Pago cancelado - Ya está manejado arriba con TBK_TOKEN
          // Este caso no debería llegar aquí, pero por seguridad
          statusEl.innerHTML = `
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-yellow-500/10 mb-3 sm:mb-4">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
              </div>
              <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Pago Cancelado</h2>
              <p class="text-white/90 mb-3 sm:mb-4 text-sm sm:text-base">Has cancelado el proceso de pago en Webpay.</p>
              <p class="text-white/70 text-xs sm:text-sm mb-4">No se ha realizado ningún cargo a tu tarjeta.</p>
              <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
                <a href="/pago?orderId=${orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
                  Intentar nuevamente
                </a>
                <a href="/" class="inline-block px-4 sm:px-6 py-2 sm:py-3 border-2 border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors text-sm sm:text-base">
                  Volver al inicio
                </a>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error confirmando pago:', error);
        statusEl.innerHTML = `
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-yellow-500/10 mb-3 sm:mb-4">
              <svg class="w-8 h-8 sm:w-10 sm:h-10 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Error al procesar</h2>
            <p class="text-white/90 mb-3 sm:mb-4 text-sm sm:text-base">Ocurrió un error al confirmar tu pago. Por favor, contacta con soporte.</p>
            <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
              <a href="/pago?orderId=${orderId}" class="inline-block px-4 sm:px-6 py-2 sm:py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-sm sm:text-base">
                Volver al pago
              </a>
              <a href="/" class="inline-block px-4 sm:px-6 py-2 sm:py-3 border-2 border-primary text-primary rounded-lg hover:bg-primary/10 transition-colors text-sm sm:text-base">
                Volver al inicio
              </a>
            </div>
          </div>
        `;
      }
    });
  </script>
</BaseLayout>

